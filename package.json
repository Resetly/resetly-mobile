{
  "name": "resetly-mobile",
  "main": "expo-router/entry",
  "version": "5.0.0",
  "dependencies": {
    "@expo/html-elements": "^0.12.5",
    "@expo/ui": "~57.0.11",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@legendapp/motion": "^2.5.3",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "nativewind": "^5.0.0-preview.2",
    "react": "19.2.3",
    "react-aria": "^3.53.1",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-stately": "^3.51.0",
    "tailwind-variants": "^0.1.20",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@react-native/jest-preset": "^0.86.2",
    "@swmansion/argent": "^0.22.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.79.0",
    "react-test-renderer": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky",
    "bootstrap": "node scripts/bootstrap.mjs",
    "setup:eas": "bash scripts/setup-eas.sh",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "update:dev": "npx eas-cli@latest update --channel development --non-interactive",
    "update:preview": "npx eas-cli@latest update --channel preview --non-interactive",
    "update:prod": "npx eas-cli@latest update --channel production --non-interactive",
    "e2e": "argent run flow-execute --name smoke",
    "verify": "tsc --noEmit && oxlint && jest --ci",
    "gen": "node scripts/gen.mjs",
    "sync:ai-rules": "node scripts/sync-ai-rules.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "oxlint --fix"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}

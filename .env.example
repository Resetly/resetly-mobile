# Resetly Mobile — Environment Variables
#
# Copy this file to .env.local and fill in values for your environment.
# NEVER commit .env.local or any file containing real secrets.
#
# All EXPO_PUBLIC_* variables are bundled into the JS bundle and are
# visible to anyone who inspects the app. Do not put secrets here.

# Base URL of the Resetly backend API.
# Note: On Android emulators, use 10.0.2.2 instead of localhost.
# On physical devices, use your machine's local network IP (e.g. 192.168.x.x).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# AI provider for development only. Set to "proxy" in production.
# EXPO_PUBLIC_AI_PROVIDER=proxy

